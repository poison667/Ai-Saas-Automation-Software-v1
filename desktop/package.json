{
  "name": "lumina",
  "productName": "Lumina",
  "version": "1.8.0",
  "description": "Lumina — AI Social Media Suite. Generate, schedule and analyze social content with AI.",
  "main": "main.js",
  "author": "Lumina",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "social.lumina.app",
    "productName": "Lumina",
    "files": [
      "main.js",
      "icon.png",
      "icon.ico",
      "package.json"
    ],
    "extraResources": [
      { "from": "backend/Lumina-backend.exe", "to": "backend/Lumina-backend.exe" }
    ],
    "directories": { "output": "release" },
    "win": {
      "icon": "icon.ico",
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "artifactName": "Lumina-Desktop-${arch}.exe"
    },
    "mac": { "icon": "icon.png", "category": "public.app-category.social-networking", "target": ["dmg", "zip"] },
    "linux": { "icon": "icon.png", "category": "Network", "target": ["AppImage", "deb"] }
  }
}
